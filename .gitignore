# .gitignore only governs files git is NOT already tracking. If something keeps
# appearing on GitHub after being listed here, it was committed before the rule
# existed — untrack it explicitly:
#
#   git rm -r --cached <path> && git commit -m "untrack <path>"
#
# (This is what happened to .claude/launch.json.)

# Foundry
cache/
out/
broadcast/
lcov.info

# Secrets - never commit
.env
.env.local
.env.sepolia.bak
.env.*
!.env.example
*.pem
*.key
keystore/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/
env/

# Node
node_modules/
dist/
build/
.next/
coverage/
*.tsbuildinfo
.vite/
npm-debug.log*
yarn-error.log*

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
.claude/
.cursor/
*.swp

# Agent tooling
.agents/
.plamen/
skills-lock.json

# Temporary / Scratchpad folders
.scratchpad/

# Video project (Remotion) - large local node_modules and render output
video/

# Media / marketing assets - local only, not part of the source tree
Media Kit/

# Logs and backups
*.log
*.bak
*.tmp
deployments/*.log
