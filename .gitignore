# .gitignore only governs files git is NOT already tracking. If something keeps
# appearing on GitHub after being listed here, it was committed before the rule
# existed — untrack it explicitly:
#
#   git rm -r --cached <path> && git commit -m "untrack <path>"
#
# (This is what happened to .claude/launch.json.)

# ── Secrets - never commit ──────────────────────────────────────────────
# Real key material, any environment, any backup of it. Only the redacted
# .env.example is allowed through (negated last so earlier rules can't win).
.env
.env.*
!.env.example
*.pem
*.key
keystore/
*.keystore
# Private-key exports and signatures generated while testing signers
offchain/*.sig

# ── Foundry ─────────────────────────────────────────────────────────────
cache/
out/
broadcast/
lcov.info
coverage.json
# Local deployment records beyond the committed templates.
# are runtime logs from deploy scripts, not source)
deployments/*.log

# ── Node ────────────────────────────────────────────────────────────────
node_modules/
dist/
build/
.next/
.vite/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/
env/

# ── Rust (foundry toolchain sometimes builds locally) ───────────────────
target/

# ── IDE / OS ────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# ── Agent tooling ───────────────────────────────────────────────────────
.claude/
.cursor/
.agents/
.plamen/
skills-lock.json

# ── Scratch / logs / temp ───────────────────────────────────────────────
.scratchpad/
*.log
*.bak
*.tmp
*.orig

# ── Video project (Remotion) - large local node_modules and render output
video/

# ── Media / marketing assets - local only, not part of the source tree ──
Media Kit/

# ── Local notes / drafts - personal, not project source ─────────────────
Post.md
Note.md

# Telegram bot runtime state (public wallet links, persisted via Railway volume)
telegram-bot/data/
