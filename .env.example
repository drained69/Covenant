# Covenant environment — template.
# Copy to `.env` and fill in. Never commit `.env` — it is gitignored.
# Search for "# FILL:" to see what needs a value.

# ─────────────────────────────────────────────────────────────────────────────
# 1. DEPLOYMENT
# ─────────────────────────────────────────────────────────────────────────────

# Optional: WalletConnect Cloud project id for mobile wallet QR/deep-links.
# Browser extension wallets work without this value.
VITE_WALLETCONNECT_PROJECT_ID=

# FILL: deployer private key, hex with 0x prefix.
PRIVATE_KEY=

# Target chain RPC: Mezo testnet.
RPC_URL=https://rpc.test.mezo.org
CHAIN_ID=31611
EXPLORER_URL=https://explorer.test.mezo.org

# ─────────────────────────────────────────────────────────────────────────────
# 2. CLEANVERSE API
# ─────────────────────────────────────────────────────────────────────────────

# Sandbox base. Swap for the production URL when going live.
CLEANVERSE_BASE_URL=https://uatapi.cleanverse.com/api/cooperate

# FILL: credentials issued by Cleanverse.
# api-id is transmitted; api-key is a LOCAL AES key that must never be sent.
CLEANVERSE_API_ID=
CLEANVERSE_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# 3. CLEANVERSE COMPLIANCE VALIDATOR (CCP V2)
# ─────────────────────────────────────────────────────────────────────────────

# Cleanverse chain identifier, if compliance integration is enabled.
CLEANVERSE_CHAIN=ethereum

# The CVI Compliance Validator (IAPassComplianceValidator). Cleanverse deploys this once per chain
# via CREATE2, so the same address works everywhere they've deployed it. Announced 2026-08 for the
# hackathon.
CLEANVERSE_VALIDATOR_ADDRESS=0xaC7e5179C2C7f03f209136886c172eb34F161792

# Legacy alias — kept so old scripts / tooling that reads POOL_ADDRESS still finds the value.
# New code should read CLEANVERSE_VALIDATOR_ADDRESS. This is the SAME value.
CLEANVERSE_POOL_ADDRESS=0xaC7e5179C2C7f03f209136886c172eb34F161792

# FILL (optional): a wallet with an A-Pass, used only for smoke testing.
CLEANVERSE_TEST_WALLET=

# ─────────────────────────────────────────────────────────────────────────────
# 4. DEPLOYED ADDRESSES — populate after running the deploy script
# ─────────────────────────────────────────────────────────────────────────────

COVENANT_CORE_ADDRESS=
COVENANT_GATE_ADDRESS=
COVENANT_REGISTRY_ADDRESS=
