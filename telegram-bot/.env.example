# Telegram — create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram numeric user IDs allowed to run /execute.
TELEGRAM_ADMIN_IDS=

# Public Covenant frontend and credit service.
COVENANT_WEB_URL=https://covenantv1.up.railway.app
COVENANT_API_URL=https://covenant-api-production-1ce1.up.railway.app
TELEGRAM_WEB_APP_URL=https://covenantv1.up.railway.app/telegram/connect

# DreamDEX / Somnia Shannon testnet.
NETWORK=testnet
RPC_URL=https://api.infra.testnet.somnia.network
WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws
INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
# Current testnet DreamDEX Event Contract venue. Venue IDs can move; if /doctor
# reports no markets, read venueId from a live market row and update this.
VENUE_ID=0x679795a0195a1b76cdebb7c51d74e058aee92919b8c3389af86ef24535e8a28c

# Live execution and custody are OFF unless their explicit flags and a
# dedicated testnet key are set. Never use a user's key or ask users to paste
# keys into Telegram. Prefer a KMS/HSM-backed signer in production; this env
# key is intended only for a disposable testnet operator wallet.
BOT_TRADING_ENABLED=false
BOT_CUSTODY_ENABLED=false
BOT_PRIVATE_KEY=
BOT_MAX_ORDER_USD=25

# JSON state for linked public wallet addresses. Mount a Railway volume here
# for persistence across deploys; otherwise the container filesystem is ephemeral.
BOT_STATE_FILE=./data/state.json

# HTTP health server used by Railway.
PORT=8080
